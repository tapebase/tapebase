NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local import only. Copy a secret backend key from Supabase; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Credentials for the local Spotify importer; never use NEXT_PUBLIC_ here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Osobny losowy sekret (minimum 32 znaki) do szyfrowania tokenów użytkowników.
SPOTIFY_TOKEN_ENCRYPTION_KEY=
TICKETMASTER_API_KEY=
CONCERT_SYNC_SECRET=
CONCERT_SYNC_BATCH_SIZE=20
YOUTUBE_API_KEY=
YOUTUBE_SYNC_SECRET=
YOUTUBE_SYNC_BATCH_SIZE=10

# Transactional e-mail notifications. Keep the API key server-side.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TAPEBASE <powiadomienia@tapebase.pl>
