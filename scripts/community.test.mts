const draftSchema = `
  create role anon;
  create role authenticated;
  create role service_role bypassrls;
  create schema auth;
  create schema storage;
  create table auth.users (
    id uuid primary key,
    raw_user_meta_data jsonb not null default '{}'::jsonb
  );
  create function auth.uid() returns uuid language sql stable
    as $$ select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid $$;
  create function storage.foldername(name text) returns text[] language sql immutable
    as $$ select string_to_array(name, '/') $$;
  create table storage.buckets (
    id text primary key, name text not null, public boolean not null default false,
    file_size_limit bigint, allowed_mime_types text[]
  );
  create table storage.objects (
    id bigint generated by default as identity primary key,
    bucket_id text not null references storage.buckets(id), name text not null
  );
  alter table storage.objects enable row level security;
  grant usage on schema public, auth, storage to anon, authenticated, service_role;
  grant execute on function auth.uid() to anon, authenticated;
  grant execute on function storage.foldername(text) to anon, authenticated;
  grant select on storage.objects to anon, authenticated;
  grant insert, update, delete on storage.objects to authenticated;
  create table public.artists (id bigint generated by default as identity primary key, name text, slug text, image_url text);
  create table public.albums (id bigint generated by default as identity primary key, title text, slug text);
  create table public.album_artists (album_id bigint references public.albums(id), artist_id bigint references public.artists(id), position integer, primary key(album_id,artist_id));
  grant select on public.artists, public.albums, public.album_artists to anon, authenticated;
  create table public.users (id bigint primary key, username text not null, email text unique, avatar_url text, role text default 'user', created_at timestamptz default now(), updated_at timestamptz default now());
  create table public.ratings (id bigint primary key, user_id bigint references public.users(id), album_id bigint references public.albums(id), rating numeric not null, created_at timestamptz default now(), updated_at timestamptz default now(), unique(user_id,album_id));
  create table public.comments (id bigint primary key, user_id bigint references public.users(id), album_id bigint references public.albums(id), content text not null, created_at timestamptz default now(), updated_at timestamptz default now());
  create table public.listened (id bigint primary key, user_id bigint references public.users(id), album_id bigint references public.albums(id), created_at timestamptz default now(), unique(user_id,album_id));
  create table public.want_to_listen (id bigint primary key, user_id bigint references public.users(id), album_id bigint references public.albums(id), created_at timestamptz default now(), unique(user_id,album_id));
  alter table public.users enable row level security;
  alter table public.ratings enable row level security;
  alter table public.comments enable row level security;
  alter table public.listened enable row level security;
  alter table public.want_to_listen enable row level security;
`;

test("auth input validation rejects unsafe redirects and invalid credentials", () => {
  assert.equal(safeNextPath("/album/test"), "/album/test");
  assert.equal(safeNextPath("//evil.example", "/"), "/");
  assert.equal(safeNextPath("https://evil.example", "/profil"), "/profil");
  assert.equal(validateEmail(" USER@example.com "), "user@example.com");
  assert.equal(validateEmail("wrong"), null);
  assert.equal(validateUsername("Tape_User"), "Tape_User");
  assert.equal(validateUsername("nie poprawne"), null);
  assert.equal(validatePassword("album123"), "album123");
  assert.equal(validatePassword("short1"), null);
});

test("password recovery keeps the current local host and rejects foreign origins", () => {
  const configured = process.env.NEXT_PUBLIC_SITE_URL;
  delete process.env.NEXT_PUBLIC_SITE_URL;

  try {
    assert.equal(siteUrl("http://127.0.0.1:3000/reset-hasla"), "http://127.0.0.1:3000");
    assert.equal(siteUrl("http://localhost:3000/reset-hasla"), "http://localhost:3000");
    assert.equal(siteUrl("https://evil.example/reset-hasla"), "http://localhost:3000");
  } finally {
    if (configured === undefined) delete process.env.NEXT_PUBLIC_SITE_URL;
    else process.env.NEXT_PUBLIC_SITE_URL = configured;
  }
});

test("artist origin defaults to Poland and keeps explicit alternatives", () => {
  assert.equal(countryFilter(undefined), "PL");
  assert.equal(countryFilter("PL"), "PL");
  assert.equal(countryFilter("INT"), "INT");
  assert.equal(countryFilter("all"), "all");
});

