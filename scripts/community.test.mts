test("community migration refuses to replace non-empty draft tables", async () => {
  const db = new PGlite();
  try {
    await db.exec(draftSchema);
    await db.exec("insert into public.users(id,username) values (1,'existing')");
    await assert.rejects(db.exec(migration), /requires the five draft tables to be empty/);
    await db.exec("rollback");
    assert.equal((await db.query("select username from public.users")).rows.length, 1);
  } finally {
    await db.close();
  }
});
