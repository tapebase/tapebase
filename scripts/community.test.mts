    await db.exec("set role anon");
    assert.equal((await db.query<{ count: string }>("select public.imported_album_count($1)::text as count", [alice])).rows[0].count, "2");
    await db.exec("reset role");

    await db.query("insert into public.artists(name,slug,spotify_id) values ('Gość','gosc','DDDDDDDDDDDDDDDDDDDDDD')");
    await db.query("insert into public.albums(title,slug,spotify_id) values ('Szkielet albumu','szkielet','EEEEEEEEEEEEEEEEEEEEEE')");
    await db.query("select set_config('request.jwt.claim.sub',$1,false)", [alice]);
    await db.exec("set role authenticated");
    await db.query("select public.submit_spotify_catalog_item('artist','DDDDDDDDDDDDDDDDDDDDDD','Gość',null,'PL','rock')");
    await db.query("select public.submit_spotify_catalog_item('album','EEEEEEEEEEEEEEEEEEEEEE','Szkielet albumu',null,'PL','pop')");
    await db.exec("reset role");
    assert.deepEqual((await db.query("select country_code from public.catalog_submissions where spotify_id='DDDDDDDDDDDDDDDDDDDDDD'")).rows, [{ country_code: "PL" }]);
    assert.equal((await db.query<{ count: number }>("select count(*)::integer as count from public.catalog_submissions where spotify_id in ('DDDDDDDDDDDDDDDDDDDDDD','EEEEEEEEEEEEEEEEEEEEEE')")).rows[0].count, 2);
    await db.query("update public.catalog_submissions set status='rejected', moderator_id=$1, rejection_reason='Duplikat' where spotify_id='DDDDDDDDDDDDDDDDDDDDDD'", [alice]);
    assert.deepEqual((await db.query("select action,rejection_reason from public.catalog_moderation_history")).rows, [
